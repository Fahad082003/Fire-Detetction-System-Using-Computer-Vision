# ---- Django ----
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ---- Infrastructure (leave REDIS_URL empty for in-memory dev mode) ----
REDIS_URL=
# POSTGRES_DB=sentinel
# POSTGRES_USER=sentinel
# POSTGRES_PASSWORD=sentinel
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# ---- Access control ----
# OPEN_ACCESS=True lets anyone use the dashboard/API (local demo only).
SENTINEL_OPEN_ACCESS=True
# Shared secret used by AI processes / IoT gateways (X-Device-Key header or ?token= on WebSocket).
SENTINEL_DEVICE_API_KEY=dev-device-key

# ---- Alert engine ----
SENTINEL_SITE_NAME=Sentinel HQ
SENTINEL_ALERT_COOLDOWN_SECONDS=120
SENTINEL_INCIDENT_MERGE_WINDOW_SECONDS=90
SENTINEL_SMOKE_CRITICAL_MULTIPLIER=1.5
SENTINEL_TEMP_CRITICAL_MULTIPLIER=1.25
SENTINEL_DASHBOARD_URL=http://localhost:8000/

# ---- Twilio SMS ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SENTINEL_SMS_RECIPIENTS=
SENTINEL_SMS_MIN_SEVERITY=High

# ---- Email ----
# Leave EMAIL_HOST empty to print emails to the console.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Sentinel Alerts <alerts@example.com>
SENTINEL_EMAIL_RECIPIENTS=
SENTINEL_EMAIL_MIN_SEVERITY=Medium

# ---- Web Push (generate with: python manage.py generate_vapid_keys) ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:ops@example.com
SENTINEL_PUSH_MIN_SEVERITY=Medium
