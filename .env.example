# Copy this file to ".env" (same folder) and fill in values. Never commit ".env" — it holds real secrets.
# Keys use the ASP.NET Core "Section__Key" format and override backend/Sentinel.Api/appsettings.json.
# Real environment variables always win over values in this file.

# ---- Database (Windows authentication, default SQL Server instance) ----
# LocalDB alternative: Server=(localdb)\MSSQLLocalDB;Database=SentinelDb;Trusted_Connection=True;TrustServerCertificate=True
ConnectionStrings__Sentinel=Server=localhost;Database=SentinelDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true

# ---- Security (REQUIRED) ----
# JWT signing key: random text, at least 32 characters. PowerShell: [Convert]::ToBase64String((1..48 | % {Get-Random -Max 256}))
Jwt__SigningKey=
# Shared secret for AI pipelines / IoT gateways / the simulator (sent as X-Device-Key)
Device__ApiKey=

# ---- First admin account (created on first start when the Users table is empty) ----
Seed__AdminEmail=admin@sentinel.local
# Leave empty to have a random password generated and printed once in the API console.
Seed__AdminPassword=

# ---- Frontend origin(s) allowed by CORS ----
Cors__AllowedOrigins__0=http://localhost:4200

# ---- Twilio SMS (optional) ----
Notifications__Sms__TwilioAccountSid=
Notifications__Sms__TwilioAuthToken=
Notifications__Sms__FromNumber=
# Comma-separated E.164 numbers, e.g. +923001234567,+923331234567
Notifications__Sms__Recipients=

# ---- Email (optional). Empty SmtpHost = "console mode": emails are printed in the API log ----
Notifications__Email__SmtpHost=
Notifications__Email__SmtpPort=587
Notifications__Email__UseStartTls=true
Notifications__Email__Username=
Notifications__Email__Password=
Notifications__Email__From=alerts@sentinel.local
Notifications__Email__Recipients=

# ---- Web Push (optional). Generate with: dotnet run --project backend/Sentinel.Api -- generate-vapid-keys ----
Notifications__WebPush__PublicKey=
Notifications__WebPush__PrivateKey=
Notifications__WebPush__Subject=mailto:ops@sentinel.local
